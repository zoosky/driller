{# Default page template, used for pages outside the documentation section
   such as the changelog. It is also the fallback when a page names a
   template the theme does not provide. #}
{% extends "base.html.jinja" %}

{% block content %}
<article>
    {% include "breadcrumbs.html.jinja" %}

    <h1>{{ page.title }}</h1>

    <div class="content prose">
        {{ page.content | safe }}
    </div>

    {% if page.tags %}
    <div class="tags">
        {% for tag in page.tags %}
        <a href="{{ url('/tags/' ~ tag) }}" class="tag">{{ tag }}</a>
        {% endfor %}
    </div>
    {% endif %}
</article>
{% endblock %}
