{# Table of contents for the current page, limited to second- and
   third-level headings so long reference pages stay scannable. #}
{% if page.toc %}
<nav class="toc" aria-label="Table of contents">
    <h4>On this page</h4>
    <ul>
    {% for entry in page.toc %}{% if entry.level <= 3 %}
        <li class="toc-level-{{ entry.level }}">
            <a href="#{{ entry.id }}">{{ entry.text }}</a>
        </li>
    {% endif %}{% endfor %}
    </ul>
</nav>
{% endif %}
